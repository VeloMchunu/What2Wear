<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="What2Wear.AppShell" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:What2Wear">
    <TabBar>
        <ShellContent Title="Login" ContentTemplate="{DataTemplate local:LoginPage}" Route="login" />
        <ShellContent Title="Signup" ContentTemplate="{DataTemplate local:SignupPage}" Route="signup" />
    </TabBar>
    <ShellContent Title="Photos" ContentTemplate="{DataTemplate local:PhotosPage}" Route="photos" />
    <ShellContent Title="Capture" ContentTemplate="{DataTemplate local:CapturePhotoPage}" Route="capture" />
    <ShellContent Title="Outfits" ContentTemplate="{DataTemplate local:OutfitThemesPage}" Route="outfits" />
</Shell>
