<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="What2Wear.OutfitThemesPage"
             Title="Outfit Suggestions"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary Source="Resources/Colors.xaml" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        <!-- Header with Gradient Background -->
        <StackLayout Grid.Row="0" Padding="20" Spacing="8">
            <StackLayout.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PrimaryGold}" Offset="0.0" />
                    <GradientStop Color="{StaticResource SeamGold}" Offset="1.0" />
                </LinearGradientBrush>
            </StackLayout.Background>
            <Label Text="Outfit Suggestions" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Cream}"/>
            <Label Text="Get AI-powered outfit recommendations" FontSize="14" TextColor="{StaticResource CreamLight}"/>
        </StackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="16" Spacing="12" BackgroundColor="{StaticResource Background}">
                <!-- Themes Grid -->
                <Label Text="Select a Theme" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,8"/>

                <CollectionView x:Name="ThemesCollectionView" SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" HorizontalItemSpacing="12" VerticalItemSpacing="12" Span="2"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="16" CornerRadius="12" HasShadow="True" BorderColor="{StaticResource Border}" BackgroundColor="{StaticResource CreamLight}">
                                <StackLayout Spacing="8">
                                    <Label Text="{Binding Icon}" FontSize="48" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Selected Outfit Display -->
                <StackLayout x:Name="OutfitDisplayStack" Spacing="16" IsVisible="False">
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Border}" Margin="0,16"/>

                    <Label Text="Your Suggested Outfit" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

                    <!-- Generated Outfit Image -->
                    <Frame Padding="0" CornerRadius="12" HasShadow="True" BorderColor="{StaticResource Border}" BackgroundColor="{StaticResource Surface}">
                        <Image x:Name="OutfitImage" Aspect="AspectFill" HeightRequest="300" BackgroundColor="{StaticResource CreamLight}"/>
                    </Frame>

                    <!-- Outfit Items List -->
                    <Label Text="Clothing Items" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,8"/>
                    <CollectionView x:Name="OutfitItemsCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Padding="12" Spacing="8" BackgroundColor="{StaticResource CreamLight}" Margin="0,4">
                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
                                        <!-- Item Image -->
                                        <Frame Padding="0" CornerRadius="8" Grid.Column="0" BorderColor="{StaticResource Border}" WidthRequest="80" HeightRequest="80">
                                            <Image Source="{Binding PhotoUrl}" Aspect="AspectFill" BackgroundColor="{StaticResource CreamDark}"/>
                                        </Frame>

                                        <!-- Item Details -->
                                        <StackLayout Grid.Column="1" Spacing="4" Padding="0,4">
                                            <Label Text="{Binding ClothingType}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                            <Label Text="{Binding Reason}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap"/>
                                        </StackLayout>
                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Styling Tips -->
                    <Label Text="Styling Tips" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,12"/>
                    <Frame Padding="16" CornerRadius="8" BorderColor="{StaticResource SeamGold}" BackgroundColor="{StaticResource Cream}">
                        <Label x:Name="StylingTipsLabel" FontSize="13" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap"/>
                    </Frame>

                    <!-- Regenerate Button -->
                    <Button Text="Generate Different Suggestion" x:Name="RegenerateButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,12"/>
                </StackLayout>

                <!-- Empty State -->
                <StackLayout x:Name="EmptyState" Spacing="16" HorizontalOptions="Center" VerticalOptions="CenterAndExpand" Padding="20">
                    <Label Text="📸" FontSize="72" HorizontalTextAlignment="Center"/>
                    <Label Text="No photos uploaded yet" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"/>
                    <Label Text="Upload photos from the gallery first to get outfit suggestions" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                </StackLayout>

                <!-- Loading Indicator -->
                <StackLayout x:Name="LoadingStack" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center" IsVisible="False" Padding="20">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource PrimaryGold}" Scale="1.5"/>
                    <Label Text="Generating outfit suggestion..." FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center"/>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
